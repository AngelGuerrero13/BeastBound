[node name="Raton Tirador" instance=ExtResource("1_base")]
editor_description = "Movimiento y vida heredados de PersonajeBase; arco en Tirador. Imagen original visible; balanceo en Animaciones Personaje y cuadros en Imagen Personaje/Animacion Raton > Sprite Frames. Esta escena no utiliza el script antiguo raton_tirador.gd."
texture_filter = 1
collision_layer = 2
collision_mask = 13
motion_mode = 1
script = ExtResource("2_tirador")
retrato = ExtResource("4_imagen")
velocidad = 100.0
sprite_mira_izquierda = false
escena_flecha = ExtResource("3_flecha")

[node name="Animacion Raton" type="AnimatedSprite2D" parent="Imagen Personaje"]
editor_description = "Usa el mismo ratón de la selección. Puedes sustituir sus cuadros en Sprite Frames; el desplazamiento y el salto pertenecen a la clase base."
position = Vector2(0, -15)
sprite_frames = SubResource("Animaciones")
animation = &"reposo"
autoplay = "reposo"

[node name="Animaciones Personaje" parent="."]
libraries/ = SubResource("Visuales")

